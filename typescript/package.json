{
  "name": "@awiki/lite-cli",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "description": "TypeScript AWiki Lite CLI (parallel to the Python awiki-lite implementation)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "awiki-lite-ts": "./bin/awiki-lite-ts.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "awiki-lite-ts": "node ./bin/awiki-lite-ts.js",
    "postinstall": "node ./scripts/link-bin.mjs"
  },
  "dependencies": {
    "@awiki/anp-typescript-sdk": "0.9.3",
    "@inquirer/password": "^4.0.0",
    "commander": "^12.1.0",
    "fs-ext": "^2.1.1",
    "undici": "^6.21.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/ws": "^8.5.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^16.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
